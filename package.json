{
	"name": "announcements-api",
	"version": "1.0.0",
	"description": "REST API for announcements board with JWT auth and Prisma",
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"start": "node  dist/src/index.js",
		"dev": "tsx watch src/index.ts",
		"prisma:generate": "prisma generate",
		"prisma:migrate": "prisma migrate dev",
		"test:jest": "jest --detectOpenHandles --forceExit",
		"test": "vitest run src/__tests__/vitest/",
		"test:watch": "vitest"
	},
	"dependencies": {
		"@asteasolutions/zod-to-openapi": "^7.3.0",
		"@prisma/adapter-pg": "^7.10.0",
		"@prisma/client": "^6.19.3",
		"bcrypt": "^5.1.1",
		"cloudinary": "^2.11.0",
		"cors": "^2.8.5",
		"dotenv": "^16.6.1",
		"express": "^4.19.2",
		"express-rate-limit": "^8.7.1",
		"helmet": "^8.3.0",
		"jsonwebtoken": "^9.0.2",
		"multer": "^2.4.0",
		"pino": "^10.4.0",
		"pino-http": "^11.0.0",
		"pino-pretty": "^13.2.0",
		"swagger-ui-express": "^5.0.0",
		"zod": "^3.22.4"
	},
	"devDependencies": {
		"@types/bcrypt": "^5.0.2",
		"@types/cors": "^2.8.17",
		"@types/express": "^4.17.21",
		"@types/express-rate-limit": "^5.1.3",
		"@types/jest": "^29.5.12",
		"@types/jsonwebtoken": "^9.0.6",
		"@types/multer": "^2.3.0",
		"@types/node": "^20.19.43",
		"@types/supertest": "^6.0.2",
		"@types/swagger-ui-express": "^4.1.6",
		"jest": "^29.7.0",
		"prisma": "^6.12.0",
		"supertest": "^6.3.4",
		"ts-jest": "^29.1.2",
		"tsx": "^4.23.15",
		"typescript": "^5.9.3",
		"vitest": "^3.2.7"
	}
}
